{
  "name": "arksql",
  "version": "0.2.2",
  "description": "ArkSQL — SQL Server IDE with Git-based version control (Version-Controlled SQL)",
  "main": "./out/main/index.js",
  "author": "21c Care",
  "license": "MIT",
  "private": true,
  "updateRepo": "Ark-Devs/SQL-Version-Control-IDE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:backend": "go -C backend test ./...",
    "dist": "npm run build:backend && electron-vite build && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.10.8",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
